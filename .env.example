# Obavezno promijeni prije produkcije!
CSMS_SECRET_KEY=generiraj-dugi-nasumicni-niz
CSMS_ADMIN_EMAIL=admin@tvrtka.hr
CSMS_ADMIN_PASSWORD=promijeni-me-odmah
CSMS_PUBLIC_HOSTNAME=ocpp.tvrtka.hr
CSMS_DEFAULT_PRICE=0.35
CSMS_COOKIE_SECURE=1
CSMS_AUTO_REGISTER=1
# Vlastiti TLS certifikat (npr. Let's Encrypt) umjesto ugrađenog CA za wss:// port:
# CSMS_TLS_CERT_FILE=/data/tls/fullchain.pem
# CSMS_TLS_KEY_FILE=/data/tls/privkey.pem
