# ===== Obavezno promijeni prije pokretanja =====
# Dugi nasumični niz, npr. rezultat naredbe: openssl rand -hex 32
CSMS_SECRET_KEY=zamijeni-me
# Prvi administrator (kreira se samo pri prvom pokretanju)
CSMS_ADMIN_EMAIL=admin@tvrtka.hr
CSMS_ADMIN_PASSWORD=zamijeni-me-dugom-lozinkom
# Domena koja pokazuje na server (DNS A zapis), npr. ocpp.tvrtka.hr
CSMS_PUBLIC_HOSTNAME=ocpp.tvrtka.hr
# E-mail za Let's Encrypt obavijesti
CSMS_ACME_EMAIL=admin@tvrtka.hr

# ===== Po želji =====
# Zadana cijena EUR/kWh (kasnije se mijenja u sučelju)
CSMS_DEFAULT_PRICE=0.35
# Nepoznate punionice se same prijave i čekaju odobrenje (1) ili se odbijaju (0)
CSMS_AUTO_REGISTER=1
# Za lokalnu probu bez HTTPS-a (docker-compose.yml) ostavi 0, u produkciji ga compose postavlja na 1
CSMS_COOKIE_SECURE=0
# Vremenska zona za prikaz i mjesečni obračun
CSMS_TIMEZONE=Europe/Zagreb

# ===== E-mail obavijesti (po želji; bez ovoga rade samo obavijesti na mobitel) =====
# Javni URL sučelja za poveznice u e-mailu
#CSMS_PUBLIC_BASE_URL=https://ocpp.tvrtka.hr
#CSMS_SMTP_HOST=smtp.office365.com
#CSMS_SMTP_PORT=587
#CSMS_SMTP_USER=punjenje@tvrtka.hr
#CSMS_SMTP_PASSWORD=lozinka
#CSMS_SMTP_FROM=punjenje@tvrtka.hr
# starttls (port 587) | ssl (port 465) | none
#CSMS_SMTP_TLS=starttls
